# Docker image versions and build settings
ODOO_VERSION=18.0
PSQL_VERSION=16
PYTHON_VERSION=3.12
OS_VARIANT=slim-bookworm
WKHTMLTOX_VERSION=0.12.6.1-3
ODOO_BASEPATH=/opt/odoo
ODOO_CMD=/opt/odoo/odoo-bin
ODOO_RC=/etc/odoo/odoo.conf

# Provide separate private values for app, database bootstrap, and Odoo master passwords.
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=
POSTGRES_ADMIN_USER=odoo_admin
POSTGRES_ADMIN_PASSWORD=
ADMIN_PASSWORD=
LIST_DB=False

# Container paths used by Compose volumes
ODOO_DATA_DIR=/var/lib/odoo/data
ODOO_LOGS_DIR=/var/lib/odoo/logs
ODOO_EXTRA_ADDONS=/mnt/extra-addons
